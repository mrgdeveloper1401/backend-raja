[Unit]
Description=Raja Frontend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/raja-reserv-train
Environment=PATH=/root/.nvm/versions/node/v24.22.3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/.nvm/versions/node/v24.22.3/bin/npm run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
